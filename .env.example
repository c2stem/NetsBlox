# Copy to .env on the app server and fill in. .env is git-ignored.
PORT=8080
SERVER_PROTOCOL=https
# Cookie domain. Must match the editor's domain (editor.c2-stem.org), or the
# NetsBlox login from the classroom app will not stick.
HOST=.c2-stem.org
# MongoDB on the private DB instance (database: c2stem-editor)
MONGO_URI=mongodb://netsblox:CHANGE_ME@10.0.0.5:27017/c2stem-editor?authSource=admin
MONGO_POOL_SIZE=50
# Long random string (e.g. `openssl rand -hex 32`). Changing it logs everyone out once.
SESSION_SECRET=CHANGE_ME
NETSBLOX_BLOB_DIR=/data/blob-storage
# Keep "dev": "production" serves the prebuilt dist/app.min.js, which is older
# than the client source and needs closure-compiler to rebuild.
ENV=dev
NODE_ENV=dev
# Admin console stays off unless this is exactly "true"
VANTAGE_ENABLED=false
DEBUG=netsblox:*:info,netsblox:*:warn,netsblox:*:error
MAINTAINER_EMAIL=
REPORT_URL=
